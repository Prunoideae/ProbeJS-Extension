{
	"compilerOptions": {
		"plugins": [],
		"module": "commonjs",
		"target": "ES2020",
		"outDir": "out",
		"lib": [
			"ES2020"
		],
		"skipLibCheck": true,
		"sourceMap": true,
		"rootDir": "src",
		"strict": true, /* enable all strict type-checking options */
	},
	"exclude": [
		"sample"
	],
	"include": [
		"src/**/*.ts",
		"src/features/copilotPrompt.tsx"
	]
}